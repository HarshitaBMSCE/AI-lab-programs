def dls(state, goal, depth, visited):
    if state == goal:
        return [state]

    if depth == 0:
        return None

    visited.add(state)

    zero = state.index(0)
    row, col = divmod(zero, 3)

    moves = [
        (-1, 0),  # Up
        (1, 0),   # Down
        (0, -1),  # Left
        (0, 1)    # Right
    ]

    for dr, dc in moves:
        r, c = row + dr, col + dc

        if 0 <= r < 3 and 0 <= c < 3:
            new_zero = r * 3 + c

            new_state = list(state)
            new_state[zero], new_state[new_zero] = (
                new_state[new_zero],
                new_state[zero]
            )

            new_state = tuple(new_state)

            if new_state not in visited:
                result = dls(
                    new_state, goal, depth - 1, visited
                )

                if result:
                    return [state] + result

    return None
def ids(start, goal):
    for depth in range(50):
        visited = set()

        result = dls(start, goal, depth, visited)

        if result:
            return result

    return None


# Initial state
start = (
    1, 2, 3,
    4, 0, 6,
    7, 5, 8
)

# Goal state
goal = (
    1, 2, 3,
    4, 5, 6,
    7, 8, 0
)

# Execute IDS
solution = ids(start, goal)

# Display solution
if solution:
