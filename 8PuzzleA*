import heapq

def heuristic(state, goal):
    distance = 0

    for i in range(9):
        if state[i] != 0:
            goal_pos = goal.index(state[i])

            x1, y1 = divmod(i, 3)
            x2, y2 = divmod(goal_pos, 3)

            distance += abs(x1 - x2) + abs(y1 - y2)

    return distance


def astar(start, goal):
    pq = []
    heapq.heappush(pq, (0, start))

    parent = {start: None}
    g_cost = {start: 0}

    while pq:
        f, state = heapq.heappop(pq)

        if state == goal:
            path = []

            while state is not None:
                path.append(state)
                state = parent[state]

            return path[::-1]

        zero = state.index(0)
        row, col = divmod(zero, 3)

        moves = [
            (-1, 0),  # Up
            (1, 0),   # Down
            (0, -1),  # Left
            (0, 1)    # Right
        ]

        for dr, dc in moves:
            r, c = row + dr, col + dc

            if 0 <= r < 3 and 0 <= c < 3:
                new_zero = r * 3 + c

                new_state = list(state)
                new_state[zero], new_state[new_zero] = (
                    new_state[new_zero],
                    new_state[zero]
                )

                new_state = tuple(new_state)
                new_cost = g_cost[state] + 1

                if new_state not in g_cost or new_cost < g_cost[new_state]:

                    g_cost[new_state] = new_cost
                    parent[new_state] = state

                    h = heuristic(new_state, goal)
                    f = new_cost + h

                    heapq.heappush(pq, (f, new_state))

    return None


# Initial state
start = (
    1, 2, 3,
    4, 0, 6,
    7, 5, 8
)

# Goal state
goal = (
    1, 2, 3,
    4, 5, 6,
    7, 8, 0
)

# Execute A*
solution = astar(start, goal)

# Display solution
if solution:
    print("Solution Found!")

    for state in solution:
        for i in range(0, 9, 3):
            print(state[i:i+3])
        print()

    print("Total Moves:", len(solution) - 1)

else:
    print("No Solution Found")
