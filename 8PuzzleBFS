from collections import deque

def bfs(start, goal):

    queue = deque([(start, [start])])
    visited = {start}

    while queue:

        state, path = queue.popleft()

        # Check goal state
        if state == goal:
            return path

        # Find blank position
        zero = state.index(0)
        row, col = divmod(zero, 3)

        # Possible moves
        moves = [
            (-1, 0),  # Up
            (1, 0),   # Down
            (0, -1),  # Left
            (0, 1)    # Right
        ]

        for dr, dc in moves:

            r = row + dr
            c = col + dc

            if 0 <= r < 3 and 0 <= c < 3:

                new_zero = r * 3 + c

                new_state = list(state)

                new_state[zero], new_state[new_zero] = (
                    new_state[new_zero],
                    new_state[zero]
                )

                new_state = tuple(new_state)

                if new_state not in visited:

                    visited.add(new_state)

                    queue.append(
                        (new_state, path + [new_state])
                    )

    return None


# Initial state
start = (
    1, 2, 3,
    4, 0, 6,
    7, 5, 8
)

# Goal state
goal = (
    1, 2, 3,
    4, 5, 6,
    7, 8, 0
)

# Execute BFS
solution = bfs(start, goal)

# Display result
if solution:

    print("Solution Found!")

    for state in solution:

        for i in range(0, 9, 3):
            print(state[i:i+3])

        print()

    print("Total Moves:", len(solution) - 1)

else:
    print("No Solution Found")
